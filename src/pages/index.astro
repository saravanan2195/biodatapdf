---
// biodatapdf.com - Exact Match Astro Layout based on Reference Video
const title = "Professional Matrimonial Biodata & Document Generator | Biodatapdf.com";
const description = "Create an impressive marriage biodata in 2 minutes. Choose from Royal Vedic, Muslim, Christian, Sikh, and Modern minimalist layouts with real-time preview and instant PDF export.";
---

<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<title>{title}</title>
		<meta name="description" content={description} />
		
		<!-- Tailwind CSS CDN -->
		<script src="https://cdn.tailwindcss.com"></script>
		<!-- Google Fonts -->
		<link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700&display=swap" rel="stylesheet">
		<!-- jsPDF Library -->
		<script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf/2.5.1/jspdf.umd.min.js"></script>
		<!-- Cropper.js CSS & JS -->
		<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/cropperjs/1.5.13/cropper.min.css" />
		<script src="https://cdnjs.cloudflare.com/ajax/libs/cropperjs/1.5.13/cropper.min.js"></script>

		<script>
			tailwind.config = {
				theme: {
					extend: {
						fontFamily: {
							sans: ['"Plus Jakarta Sans"', 'sans-serif'],
						},
					}
				}
			}
		</script>
		
		<style>
			body { background-color: #f8fafc; color: #0f172a; }
			.dropdown-container:hover .dropdown-menu { display: block; }
			.tab-btn.active { border-bottom: 2px solid #e11d48; color: #e11d48; font-weight: 600; }
		</style>
	</head>
	<body class="font-sans antialiased min-h-screen">

		<!-- Top Header Bar -->
		<header class="bg-white border-b border-slate-200 sticky top-0 z-50">
			<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-16 flex items-center justify-between">
				
				<!-- Logo & Branding -->
				<div class="flex items-center space-x-8">
					<div class="flex items-center space-x-2 cursor-pointer">
						<div class="w-8 h-8 rounded-lg bg-rose-600 flex items-center justify-center font-bold text-white text-sm shadow-md">
							b
						</div>
						<span class="text-xl font-bold tracking-tight text-slate-900">
							biodatapdf<span class="text-rose-600">.com</span>
						</span>
					</div>

					<!-- Navigation Menu with Dropdowns -->
					<nav class="hidden md:flex items-center space-x-6 text-sm font-medium text-slate-600">
						<!-- Templates Dropdown -->
						<div class="relative dropdown-container py-4">
							<button class="flex items-center space-x-1 hover:text-rose-600 transition-colors">
								<span>Templates</span>
								<span class="text-[10px]">▼</span>
							</button>
							<div class="dropdown-menu absolute top-full left-0 hidden w-64 py-2 bg-white border border-slate-200 rounded-xl shadow-xl z-50">
								<div class="px-4 py-2 text-xs font-bold text-slate-400 uppercase tracking-wider">Browse by Style</div>
								<a href="#builder" class="block px-4 py-2 hover:bg-slate-50 hover:text-rose-600 text-sm">1. Traditional & Ethnic <span class="block text-[11px] text-slate-400">Maroon & Gold</span></a>
								<a href="#builder" class="block px-4 py-2 hover:bg-slate-50 hover:text-rose-600 text-sm">2. Modern & Minimalist <span class="block text-[11px] text-slate-400">Clean Typography</span></a>
								<a href="#builder" class="block px-4 py-2 hover:bg-slate-50 hover:text-rose-600 text-sm">3. Professional & Corporate <span class="block text-[11px] text-slate-400">Structured Grids</span></a>
								<div class="border-t border-slate-100 my-1"></div>
								<button id="openAllTemplates" class="w-full text-left px-4 py-2 bg-slate-900 text-white font-semibold text-xs rounded-lg m-2 hover:bg-slate-800">View All 100 Templates →</button>
							</div>
						</div>

						<!-- Categories Dropdown -->
						<div class="relative dropdown-container py-4">
							<button class="flex items-center space-x-1 hover:text-rose-600 transition-colors">
								<span>Categories</span>
								<span class="text-[10px]">▼</span>
							</button>
							<div class="dropdown-menu absolute top-full left-0 hidden w-56 py-2 bg-white border border-slate-200 rounded-xl shadow-xl z-50">
								<div class="px-4 py-2 text-xs font-bold text-slate-400 uppercase tracking-wider">Community & Faith</div>
								<a href="#builder" class="block px-4 py-2 hover:bg-slate-50 hover:text-rose-600 text-sm">Hindu Matrimonial</a>
								<a href="#builder" class="block px-4 py-2 hover:bg-slate-50 hover:text-rose-600 text-sm">Muslim Matrimonial</a>
								<a href="#builder" class="block px-4 py-2 hover:bg-slate-50 hover:text-rose-600 text-sm">Christian Matrimonial</a>
								<a href="#builder" class="block px-4 py-2 hover:bg-slate-50 hover:text-rose-600 text-sm">Sikh Matrimonial</a>
								<a href="#builder" class="block px-4 py-2 hover:bg-slate-50 hover:text-rose-600 text-sm">Jain Matrimonial</a>
							</div>
						</div>

						<!-- Tools & Utilities Dropdown -->
						<div class="relative dropdown-container py-4">
							<button class="flex items-center space-x-1 hover:text-rose-600 transition-colors">
								<span>Tools & Utilities</span>
								<span class="text-[10px]">▼</span>
							</button>
							<div class="dropdown-menu absolute top-full left-0 hidden w-56 py-2 bg-white border border-slate-200 rounded-xl shadow-xl z-50">
								<a href="#builder" class="block px-4 py-2 hover:bg-slate-50 hover:text-rose-600 text-sm font-medium">Photo Resizer & Cropper <span class="block text-[11px] text-slate-400">Circle & square frame</span></a>
								<a href="#builder" class="block px-4 py-2 hover:bg-slate-50 hover:text-rose-600 text-sm font-medium">PDF Compressor <span class="block text-[11px] text-slate-400">Optimize for WhatsApp</span></a>
								<a href="#builder" class="block px-4 py-2 hover:bg-slate-50 hover:text-rose-600 text-sm font-medium">Language Converter <span class="block text-[11px] text-slate-400">Hindi, Tamil, Telugu, etc.</span></a>
							</div>
						</div>
					</nav>
				</div>

				<!-- Right Header Actions -->
				<div class="flex items-center space-x-4">
					<div class="hidden sm:flex items-center space-x-1.5 px-3 py-1 bg-amber-50 border border-amber-200 rounded-full text-amber-700 text-xs font-bold">
						<span>👑</span>
						<span>VIP Active</span>
					</div>
					<button id="headerDownloadBtn" class="px-4 py-2 text-sm font-bold text-white bg-rose-600 hover:bg-rose-500 rounded-xl shadow-md shadow-rose-600/20 transition-all flex items-center space-x-2">
						<span>📥</span>
						<span>Download PDF</span>
					</button>
				</div>
			</div>
		</header>

		<!-- Hero Sub-Header & Feature Badges -->
		<section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pt-8 pb-4">
			<div class="flex flex-col lg:flex-row lg:items-center lg:justify-between gap-6">
				<div>
					<div class="inline-flex items-center space-x-2 text-xs font-bold text-rose-600 bg-rose-50 px-3 py-1 rounded-full mb-3 border border-rose-100">
						<span>🔥</span>
						<span>160 DESIGNER TEMPLATES • 100% CLIENT-SIDE PRIVACY</span>
					</div>
					<h1 class="text-3xl sm:text-4xl font-extrabold text-slate-900 tracking-tight">
						Professional Matrimonial Biodata & Document Generator
					</h1>
					<p class="text-slate-600 text-sm sm:text-base mt-2 max-w-2xl">
						Create an impressive marriage biodata in 2 minutes. Choose from Royal Vedic, Muslim, Christian, Sikh, and Modern minimalist layouts with real-time preview and instant PDF export.
					</p>
				</div>

				<!-- Search Template Box & Browse Modal Trigger -->
				<div class="flex items-center space-x-3 bg-white p-2 rounded-2xl border border-slate-200 shadow-sm">
					<div class="flex items-center space-x-2 px-3 py-2 text-slate-400 text-sm flex-1">
						<span>🔍</span>
						<input type="text" placeholder="Find template (e.g. #1, Gold, Jain)" class="bg-transparent focus:outline-none text-slate-900 w-full text-xs" />
					</div>
					<button id="browseAllBtn" class="px-5 py-2.5 bg-slate-900 hover:bg-slate-800 text-white font-semibold text-xs rounded-xl transition-all whitespace-nowrap shadow">
						Browse All 100
					</button>
				</div>
			</div>

			<!-- Quick Feature Pills -->
			<div class="flex flex-wrap items-center gap-6 mt-6 text-xs text-slate-600 font-medium">
				<div class="flex items-center space-x-2">
					<span class="w-2 h-2 rounded-full bg-emerald-500"></span>
					<span>Private: Data stays in your browser</span>
				</div>
				<div class="flex items-center space-x-2">
					<span class="w-2 h-2 rounded-full bg-indigo-500"></span>
					<span>A4 Vector PDF: Crystal sharp print ready</span>
				</div>
				<div class="flex items-center space-x-2">
					<span class="w-2 h-2 rounded-full bg-amber-500"></span>
					<span>100 Layouts: 1 click instant switch</span>
				</div>
				<div class="flex items-center space-x-2">
					<span class="w-2 h-2 rounded-full bg-rose-500"></span>
					<span>WhatsApp Ready: Instant PNG export</span>
				</div>
			</div>
		</section>

		<!-- Main Builder Section -->
		<main class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-6">
			
			<!-- Toolbar: Auto-Fill & Photo Control Bar -->
			<div class="bg-white rounded-2xl p-4 border border-slate-200 shadow-sm mb-6 flex flex-wrap items-center justify-between gap-4">
				<div class="flex items-center space-x-3">
					<span class="text-xs font-bold text-slate-400 uppercase tracking-wider">Auto-fill:</span>
					<button type="button" id="groomSampleBtn" class="px-3 py-1.5 bg-slate-100 hover:bg-slate-200 text-slate-700 text-xs font-semibold rounded-lg transition-all">
						 groom sample
					</button>
					<button type="button" id="brideSampleBtn" class="px-3 py-1.5 bg-slate-100 hover:bg-slate-200 text-slate-700 text-xs font-semibold rounded-lg transition-all">
						 bride sample
					</button>
				</div>

				<div class="flex items-center space-x-4">
					<div class="flex items-center space-x-2 text-xs text-slate-500 bg-slate-50 px-3 py-1.5 rounded-xl border border-slate-200">
						<span>📸 Candidate Photograph</span>
						<span class="text-slate-400">|</span>
						<span class="text-rose-600 font-medium">Crop to circle or square frame for your template</span>
					</div>
					<input type="file" id="imageInput" accept="image/*" class="hidden" />
					<button type="button" id="removePhotoBtn" class="text-xs text-rose-600 hover:underline font-semibold">Remove</button>
					<button type="button" id="triggerCropBtn" class="px-3 py-1.5 bg-rose-600 hover:bg-rose-500 text-white text-xs font-bold rounded-xl shadow-sm transition-all">
						Adjust Crop
					</button>
					<button type="button" id="saveDraftBtn" class="text-xs text-slate-600 hover:text-slate-900 font-medium flex items-center space-x-1">
						<span>💾</span>
						<span>Save Draft</span>
					</button>
					<button type="button" id="resetBtn" class="text-xs text-slate-600 hover:text-slate-900 font-medium flex items-center space-x-1">
						<span>🔄</span>
						<span>Reset</span>
					</button>
				</div>
			</div>

			<!-- Cropper Container Modal / Box -->
			<div id="cropperContainer" class="hidden bg-slate-900 p-4 rounded-2xl mb-6 shadow-xl max-w-md mx-auto text-center">
				<div class="max-h-60 overflow-hidden mb-3">
					<img id="imageToCrop" class="max-w-full block mx-auto" />
				</div>
				<button type="button" id="applyCropBtn" class="px-4 py-2 bg-rose-600 text-white text-xs font-bold rounded-xl shadow">
					Apply Cropped Photo
				</button>
			</div>

			<!-- Form Tabs Navigation -->
			<div class="bg-white rounded-t-2xl border-x border-t border-slate-200 px-6 pt-3 flex items-center space-x-8 overflow-x-auto">
				<button type="button" class="tab-btn active pb-3 text-xs font-semibold flex items-center space-x-1.5" data-tab="personal">
                   <span>👤</span> <span>Personal</span>
                </button>
				<button type="button" class="tab-btn pb-3 text-xs font-semibold text-slate-500 hover:text-slate-900 flex items-center space-x-1.5" data-tab="faith">
                   <span>🕉️</span> <span>Faith & Astro</span>
                </button>
				<button type="button" class="tab-btn pb-3 text-xs font-semibold text-slate-500 hover:text-slate-900 flex items-center space-x-1.5" data-tab="career">
                   <span>🎓</span> <span>Career & Edu</span>
                </button>
				<button type="button" class="tab-btn pb-3 text-xs font-semibold text-slate-500 hover:text-slate-900 flex items-center space-x-1.5" data-tab="family">
                   <span>👨‍👩‍👦</span> <span>Family</span>
                </button>
				<button type="button" class="tab-btn pb-3 text-xs font-semibold text-slate-500 hover:text-slate-900 flex items-center space-x-1.5" data-tab="contact">
                   <span>📞</span> <span>Contact</span>
                </button>
				<button type="button" class="tab-btn pb-3 text-xs font-semibold text-slate-500 hover:text-slate-900 flex items-center space-x-1.5" data-tab="expectations">
                   <span>💍</span> <span>Expectations</span>
                </button>
			</div>

			<!-- Tab Contents Container -->
			<div class="bg-white rounded-b-2xl border border-slate-200 p-6 shadow-sm mb-8">
				
				<!-- TAB 1: Personal -->
				<div id="tab-personal" class="tab-content space-y-4">
					<div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
						<div>
							<label class="block text-xs font-semibold text-slate-500 mb-1">Full Name of Candidate *</label>
							<input type="text" id="fullName" value="Aarav Devendra Sharma" class="w-full px-3 py-2.5 rounded-xl border border-slate-200 text-sm focus:outline-none focus:border-rose-600" />
						</div>
						<div class="grid grid-cols-2 gap-2">
							<div>
								<label class="block text-xs font-semibold text-slate-500 mb-1">Gender</label>
								<select id="gender" class="w-full px-3 py-2.5 rounded-xl border border-slate-200 text-sm focus:outline-none focus:border-rose-600 bg-white">
									<option>Male</option>
									<option>Female</option>
								</select>
							</div>
							<div>
								<label class="block text-xs font-semibold text-slate-500 mb-1">Date of Birth</label>
								<input type="text" id="dob" value="14-08-1996" class="w-full px-3 py-2.5 rounded-xl border border-slate-200 text-sm focus:outline-none focus:border-rose-600" />
							</div>
						</div>
						<div>
							<label class="block text-xs font-semibold text-slate-500 mb-1">Time of Birth</label>
							<input type="text" id="tob" value="06:45 AM" class="w-full px-3 py-2.5 rounded-xl border border-slate-200 text-sm focus:outline-none focus:border-rose-600" />
						</div>
						<div>
							<label class="block text-xs font-semibold text-slate-500 mb-1">Place of Birth</label>
							<input type="text" id="pob" value="Jaipur, Rajasthan" class="w-full px-4 py-2.5 rounded-xl border border-slate-200 text-sm focus:outline-none focus:border-rose-600" />
						</div>
						<div>
							<label class="block text-xs font-semibold text-slate-500 mb-1">Height</label>
							<input type="text" id="height" value="5'11\" (180 cm)" class="w-full px-3 py-2.5 rounded-xl border border-slate-200 text-sm focus:outline-none focus:border-rose-600" />
						</div>
						<div>
							<label class="block text-xs font-semibold text-slate-500 mb-1">Complexion</label>
							<input type="text" id="complexion" value="Fair" class="w-full px-3 py-2.5 rounded-xl border border-slate-200 text-sm focus:outline-none focus:border-rose-600" />
						</div>
						<div>
							<label class="block text-xs font-semibold text-slate-500 mb-1">Blood Group</label>
							<input type="text" id="bloodGroup" value="B+ Positive" class="w-full px-3 py-2.5 rounded-xl border border-slate-200 text-sm focus:outline-none focus:border-rose-600" />
						</div>
						<div>
							<label class="block text-xs font-semibold text-slate-300 mb-1">Marital Status</label>
							<input type="text" id="maritalStatus" value="Never Married" class="w-full px-3 py-2.5 rounded-xl border border-slate-200 text-sm focus:outline-none focus:border-rose-600" />
						</div>
						<div>
							<label class="block text-xs font-semibold text-slate-500 mb-1">Mother Tongue</label>
							<input type="text" id="motherTongue" value="Hindi / English" class="w-full px-3 py-2.5 rounded-xl border border-slate-200 text-sm focus:outline-none focus:border-rose-600" />
						</div>
						<div>
							<label class="block text-xs font-semibold text-slate-500 mb-1">Diet / Lifestyle</label>
							<input type="text" id="diet" value="Vegetarian" class="w-full px-3 py-2.5 rounded-xl border border-slate-200 text-sm focus:outline-none focus:border-rose-600" />
						</div>
					</div>
				</div>

				<!-- TAB 2: Faith & Astro -->
				<div id="tab-faith" class="tab-content hidden space-y-4">
					<div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
						<div>
							<label class="block text-xs font-semibold text-slate-500 mb-1">Religion</label>
							<input type="text" id="religion" value="Hindu" class="w-full px-3 py-2.5 rounded-xl border border-slate-200 text-sm focus:outline-none focus:border-rose-600" />
						</div>
						<div>
							<label class="block text-xs font-semibold text-slate-500 mb-1">Caste</label>
							<input type="text" id="caste" value="Brahmin" class="w-full px-3 py-2.5 rounded-xl border border-slate-200 text-sm focus:outline-none focus:border-rose-600" />
						</div>
						<div>
							<label class="block text-xs font-semibold text-slate-500 mb-1">Gotra / Gothram</label>
							<input type="text" id="gotra" value="Bharadwaj" class="w-full px-3 py-2.5 rounded-xl border border-slate-200 text-sm focus:outline-none focus:border-rose-600" />
						</div>
						<div>
							<label class="block text-xs font-semibold text-slate-500 mb-1">Rashi / Moon Sign</label>
							<input type="text" id="rashi" value="Vrishabha (Taurus)" class="w-full px-3 py-2.5 rounded-xl border border-slate-200 text-sm focus:outline-none focus:border-rose-600" />
						</div>
						<div>
							<label class="block text-xs font-semibold text-slate-500 mb-1">Nakshatra / Star</label>
							<input type="text" id="nakshatra" value="Rohini" class="w-full px-3 py-2.5 rounded-xl border border-slate-200 text-sm focus:outline-none focus:border-rose-600" />
						</div>
						<div>
							<label class="block text-xs font-semibold text-slate-500 mb-1">Manglik Status</label>
							<input type="text" id="manglik" value="No (Non-Manglik)" class="w-full px-3 py-2.5 rounded-xl border border-slate-200 text-sm focus:outline-none focus:border-rose-600" />
						</div>
					</div>
				</div>

				<!-- TAB 3: Career & Edu -->
				<div id="tab-career" class="tab-content hidden space-y-4">
					<div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
						<div>
							<label class="block text-xs font-semibold text-slate-500 mb-1">Highest Qualification</label>
							<input type="text" id="education" value="B.Tech in Computer Science & MS Data Science" class="w-full px-3 py-2.5 rounded-xl border border-slate-200 text-sm focus:outline-none focus:border-rose-600" />
						</div>
						<div>
							<label class="block text-xs font-semibold text-slate-500 mb-1">College / University</label>
							<input type="text" id="college" value="Columbia University, New York" class="w-full px-3 py-2.5 rounded-xl border border-slate-200 text-sm focus:outline-none focus:border-rose-600" />
						</div>
						<div>
							<label class="block text-xs font-semibold text-slate-500 mb-1">Occupation / Job Title</label>
							<input type="text" id="occupation" value="Senior Machine Learning Engineer" class="w-full px-3 py-2.5 rounded-xl border border-slate-200 text-sm focus:outline-none focus:border-rose-600" />
						</div>
						<div>
							<label class="block text-xs font-semibold text-slate-500 mb-1">Company Name</label>
							<input type="text" id="company" value="Microsoft Corporation" class="w-full px-3 py-2.5 rounded-xl border border-slate-200 text-sm focus:outline-none focus:border-rose-600" />
						</div>
						<div>
							<label class="block text-xs font-semibold text-slate-500 mb-1">Work Location</label>
							<input type="text" id="workLocation" value="Bangalore / Hybrid" class="w-full px-3 py-2.5 rounded-xl border border-slate-200 text-sm focus:outline-none focus:border-rose-600" />
						</div>
						<div>
							<label class="block text-xs font-semibold text-slate-500 mb-1">Annual Income</label>
							<input type="text" id="income" value="48,00,000 INR (145,000 Total CTC)" class="w-full px-3 py-2.5 rounded-xl border border-slate-200 text-sm focus:outline-none focus:border-rose-600" />
						</div>
					</div>
				</div>

				<!-- TAB 4: Family -->
				<div id="tab-family" class="tab-content hidden space-y-4">
					<div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
						<div>
							<label class="block text-xs font-semibold text-slate-500 mb-1">Father's Name & Profession</label>
							<input type="text" id="father" value="Mr. Devendra Sharma (Retd. Govt. Officer)" class="w-full px-3 py-2.5 rounded-xl border border-slate-200 text-sm focus:outline-none focus:border-rose-600" />
						</div>
						<div>
							<label class="block text-xs font-semibold text-slate-500 mb-1">Mother's Name & Profession</label>
							<input type="text" id="mother" value="Mrs. Sunita Sharma (Homemaker)" class="w-full px-3 py-2.5 rounded-xl border border-slate-200 text-sm focus:outline-none focus:border-rose-600" />
						</div>
						<div>
