		<!-- Script Logic: Multi-Step, Cropper.js & jsPDF -->
		<script>
			// Multi-Step Form Management
			let currentStep = 1;
			const totalSteps = 4;
			const steps = document.querySelectorAll('.form-step');
			const stepIndicator = document.getElementById('stepIndicator');
			const stepTitle = document.getElementById('stepTitle');
			const currentStepNum = document.getElementById('currentStepNum');
			const prevBtn = document.getElementById('prevBtn');
			const nextBtn = document.getElementById('nextBtn');

			const stepNames = [
				"Personal Information",
				"Education & Career",
				"Family Background",
				"Photo & Contact Details"
			];

			function updateStepView() {
				steps.forEach((el, index) => {
					if (index + 1 === currentStep) {
						el.classList.remove('hidden');
					} else {
						el.classList.add('hidden');
					}
				});
				stepIndicator.textContent = currentStep;
				stepTitle.textContent = stepNames[currentStep - 1];
				currentStepNum.textContent = currentStep;

				prevBtn.disabled = currentStep === 1;
				nextBtn.textContent = currentStep === totalSteps ? 'Finish & Preview' : 'Next Step →';
			}

			nextBtn.addEventListener('click', () => {
				if (currentStep < totalSteps) {
					currentStep++;
					updateStepView();
				}
			});

			prevBtn.addEventListener('click', () => {
				if (currentStep > 1) {
					currentStep--;
					updateStepView();
				}
			});

			// Live Text Bindings
			const bindings = {
				fullName: { input: document.getElementById('fullName'), prev: document.getElementById('prevName') },
				dob: { input: document.getElementById('dob'), prev: document.getElementById('prevDob') },
				tob: { input: document.getElementById('tob'), prev: document.getElementById('prevTob') },
				pob: { input: document.getElementById('pob'), prev: document.getElementById('prevPob') },
				height: { input: document.getElementById('height'), prev: document.getElementById('prevHeight') },
				religion: { input: document.getElementById('religion'), prev: document.getElementById('prevReligion') },
				education: { input: document.getElementById('education'), prev: document.getElementById('prevEdu') },
				occupation: { input: document.getElementById('occupation'), prev: document.getElementById('prevOcc') },
				father: { input: document.getElementById('father'), prev: document.getElementById('prevFather') },
				mother: { input: document.getElementById('mother'), prev: document.getElementById('prevMother') },
				phone: { input: document.getElementById('phone'), prev: document.getElementById('prevPhone') },
				address: { input: document.getElementById('address'), prev: document.getElementById('prevAddress') },
			};

			Object.keys(bindings).forEach(k => {
				bindings[k].input.addEventListener('input', (e) => {
					bindings[k].prev.textContent = e.target.value || '-';
				});
			});

			// Cropper.js Integration
			let cropper = null;
			const imageInput = document.getElementById('imageInput');
			const cropperContainer = document.getElementById('cropperContainer');
			const imageToCrop = document.getElementById('imageToCrop');
			const cropBtn = document.getElementById('cropBtn');
			const photoPlaceholder = document.getElementById('photoPlaceholder');
			const previewCroppedImg = document.getElementById('previewCroppedImg');
			let croppedDataUrl = null;

			imageInput.addEventListener('change', (e) => {
				const files = e.target.files;
				if (files && files.length > 0) {
					const file = files[0];
					const reader = new FileReader();
					reader.onload = (event) => {
						imageToCrop.src = event.target.result;
						cropperContainer.classList.remove('hidden');
						if (cropper) cropper.destroy();
						cropper = new Cropper(imageToCrop, {
							aspectRatio: 3 / 4,
							viewMode: 1,
						});
					};
					reader.readAsDataURL(file);
				}
			});

			cropBtn.addEventListener('click', () => {
				if (cropper) {
					const canvas = cropper.getCroppedCanvas({ width: 300, height: 400 });
					croppedDataUrl = canvas.toDataURL('image/jpeg');
					previewCroppedImg.src = croppedDataUrl;
					previewCroppedImg.classList.remove('hidden');
					photoPlaceholder.classList.add('hidden');
					cropperContainer.classList.add('hidden');
				}
			});

			// PDF Generation via jsPDF
			document.getElementById('downloadPdfBtn').addEventListener('click', () => {
				const { jsPDF } = window.jspdf;
				const doc = new jsPDF('p', 'mm', 'a4');

				doc.setFont("Helvetica", "bold");
				doc.setFontSize(10);
				doc.setTextColor(180, 50, 50);
				doc.text("|| Shri Ganeshaya Namah ||", 105, 18, { align: "center" });

				doc.setFontSize(22);
				doc.setTextColor(20, 20, 20);
				doc.text(bindings.fullName.input.value || "Marriage Biodata", 105, 26, { align: "center" });

				doc.setFontSize(10);
				doc.setFont("Helvetica", "normal");
				doc.setTextColor(100, 100, 100);
				doc.text(bindings.religion.input.value, 105, 32, { align: "center" });

				if (croppedDataUrl) {
					doc.addImage(croppedDataUrl, 'JPEG', 165, 15, 30, 40);
				}

				let y = 44;
				function addSec(title, dataObj) {
					doc.setFont("Helvetica", "bold");
					doc.setFontSize(11);
					doc.setTextColor(180, 50, 50);
					doc.text(title, 20, y);
					doc.setDrawColor(220, 200, 200);
					doc.line(20, y + 2, 190, y + 2);
					y += 7;
					doc.setFont("Helvetica", "normal");
					doc.setFontSize(10);
					doc.setTextColor(40, 40, 40);

					Object.keys(dataObj).forEach(label => {
						doc.setFont("Helvetica", "bold");
						doc.text(label + ":", 20, y);
						doc.setFont("Helvetica", "normal");
						doc.text(dataObj[label], 55, y);
						y += 5.5;
					});
					y += 3;
				}

				addSec("Personal Information", {
					"Date of Birth": bindings.dob.input.value,
					"Time of Birth": bindings.tob.input.value,
					"Birth Place": bindings.pob.input.value,
					"Height": bindings.height.input.value
				});

				addSec("Education & Career", {
					"Highest Education": bindings.education.input.value,
					"Occupation": bindings.occupation.input.value
				});

				addSec("Family Background", {
					"Father's Details": bindings.father.input.value,
					"Mother's Details": bindings.mother.input.value
				});

				addSec("Contact Details", {
					"Mobile / WhatsApp": bindings.phone.input.value,
					"Residential Address": bindings.address.input.value
				});

				doc.setFontSize(8);
				doc.setTextColor(150, 150, 150);
				doc.text("Generated securely via Biodatapdf.com", 105, 285, { align: "center" });

				doc.save(`${(bindings.fullName.input.value || 'Marriage_Biodata').replace(/\s+/g, '_')}_Biodata.pdf`);
			});
		</script>
	</body>
