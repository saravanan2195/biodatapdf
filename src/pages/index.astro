---
// biodatapdf.com - Ultra-Premium Marriage Biodata Generator & PDF Maker
const title = "Marriage Biodata PDF Maker | Create Professional Biodata Online";
const description = "Create your marriage biodata in 2 minutes with photo cropping, custom community templates, and instant A4 PDF download. 100% private, no login required.";
---

<html lang="en" class="dark">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<title>{title}</title>
		<meta name="description" content={description} />
		
		<!-- Open Graph / SEO Meta Tags -->
		<meta property="og:title" content="Marriage Biodata PDF Maker | BiodataPDF.com" />
		<meta property="og:description" content="Create stunning marriage biodata PDFs instantly with photo cropping and custom community formats." />
		<meta property="og:type" content="website" />
		
		<!-- Tailwind CSS CDN -->
		<script src="https://cdn.tailwindcss.com"></script>
		<!-- Google Fonts -->
		<link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
		<!-- jsPDF Library -->
		<script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf/2.5.1/jspdf.umd.min.js"></script>
		<!-- Cropper.js CSS & JS -->
		<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/cropperjs/1.5.13/cropper.min.css" />
		<script src="https://cdnjs.cloudflare.com/ajax/libs/cropperjs/1.5.13/cropper.min.js"></script>

		<script>
			tailwind.config = {
				darkMode: 'class',
				theme: {
					extend: {
						fontFamily: {
							sans: ['"Plus Jakarta Sans"', 'sans-serif'],
						},
					}
				}
			}
		</script>
		
		<style>
			/* Premium Fluid Animated Background */
			.luxury-bg {
				background: radial-gradient(circle at 50% 0%, #1e1124 0%, #0b0f19 50%, #05070c 100%);
				background-size: 200% 200%;
				animation: bgShift 18s ease infinite;
			}
			@keyframes bgShift {
				0% { background-position: 0% 50%; }
				50% { background-position: 100% 50%; }
				100% { background-position: 0% 50%; }
			}
			/* Luxury Glassmorphism */
			.glass-card {
				background: rgba(18, 24, 38, 0.7);
				backdrop-filter: blur(16px);
				border: 1px solid rgba(255, 255, 255, 0.08);
				box-shadow: 0 20px 50px rgba(0, 0, 0, 0.4);
			}
			.glass-input {
				background: rgba(10, 14, 23, 0.85);
				border: 1px solid rgba(255, 255, 255, 0.1);
				transition: all 0.3s ease;
			}
			.glass-input:focus {
				border-color: #f43f5e;
				box-shadow: 0 0 15px rgba(244, 63, 94, 0.2);
			}
			/* Shimmer Animation for Premium Feel */
			@keyframes shimmer {
				0% { background-position: -200% 0; }
				100% { background-position: 200% 0; }
			}
			.shimmer-text {
				background: linear-gradient(90deg, #f43f5e 0%, #fb7185 25%, #fde047 50%, #fb7185 75%, #f43f5e 100%);
				background-size: 200% auto;
				color: transparent;
				-webkit-background-clip: text;
				animation: shimmer 5s linear infinite;
			}
			/* Custom Scrollbar */
			::-webkit-scrollbar { width: 8px; }
			::-webkit-scrollbar-track { background: #05070c; }
			::-webkit-scrollbar-thumb { background: #1e293b; border-radius: 4px; }
			::-webkit-scrollbar-thumb:hover { background: #334155; }
		</style>
	</head>
	<body class="luxury-bg text-slate-100 min-h-screen font-sans antialiased selection:bg-rose-500 selection:text-white">

		<!-- Top Header & SEO Navigation -->
		<header class="border-b border-slate-800/60 sticky top-0 z-50 glass-card">
			<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-20 flex items-center justify-between">
				<div class="flex items-center space-x-8">
					<div class="flex items-center space-x-3 group cursor-pointer">
						<div class="w-11 h-11 rounded-2xl bg-gradient-to-tr from-rose-600 via-pink-600 to-amber-500 flex items-center justify-center shadow-lg shadow-rose-600/30 font-bold text-lg text-white transform group-hover:scale-105 transition-transform">
							BP
						</div>
						<span class="text-xl font-extrabold tracking-tight text-white">
							Biodata<span class="shimmer-text">PDF</span>
						</span>
					</div>

					<!-- SEO High Search Volume Menu -->
					<nav class="hidden md:flex items-center space-x-6 text-xs font-semibold text-slate-300">
						<a href="#builder" class="hover:text-rose-400 transition-colors">Tamil Biodata</a>
						<a href="#builder" class="hover:text-rose-400 transition-colors">Hindu Marriage</a>
						<a href="#templates" class="hover:text-rose-400 transition-colors">Templates</a>
						<a href="#pricing" class="hover:text-rose-400 transition-colors">Pricing</a>
					</nav>
				</div>
				<div class="flex items-center space-x-4">
					<a href="#builder" class="px-5 py-2.5 text-xs font-bold text-white bg-gradient-to-r from-rose-600 to-pink-600 hover:from-rose-500 hover:to-pink-500 rounded-xl shadow-lg shadow-rose-600/30 transition-all transform hover:-translate-y-0.5">
						Create Biodata
					</a>
				</div>
			</div>
		</header>

		<!-- Hero Section -->
		<section class="relative pt-16 pb-12 text-center px-4 max-w-4xl mx-auto">
			<div class="inline-flex items-center space-x-2 px-4 py-1.5 rounded-full bg-rose-500/10 border border-rose-500/20 text-rose-300 text-xs font-semibold mb-6 shadow-inner">
				<span class="w-2 h-2 rounded-full bg-rose-500 animate-pulse"></span>
				<span>100% Client-Side Privacy • Instant A4 PDF Generator</span>
			</div>
			<h1 class="text-4xl sm:text-6xl font-extrabold tracking-tight text-white mb-6 leading-tight">
				Craft Your Marriage Biodata <br />
				<span class="shimmer-text">With Elegance & Precision</span>
			</h1>
			<p class="text-base sm:text-lg text-slate-400 max-w-2xl mx-auto mb-8">
				Designed for modern matchmaking. Built-in photo cropper, multi-step ease, and professional print-ready layouts tailored for your community.
			</p>
		</section>

		<!-- AdSense Banner Placeholder (Top Policy-Compliant Unit) -->
		<div class="max-w-7xl mx-auto px-4 mb-10">
			<div class="w-full h-24 bg-slate-900/40 border border-slate-800/80 rounded-2xl flex items-center justify-center text-xs text-slate-600 uppercase tracking-widest">
				Advertisement Space (AdSense Ready)
			</div>
		</div>

		<!-- Main Interactive Multi-Step Builder & Preview -->
		<main id="builder" class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pb-20">
			<div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">
				
				<!-- Left Column: Multi-Step Form Inputs -->
				<div class="lg:col-span-7 glass-card rounded-3xl p-6 sm:p-8 shadow-2xl">
					
					<!-- Step Progress Bar -->
					<div class="flex items-center justify-between mb-8 border-b border-slate-800 pb-4">
						<div class="flex items-center space-x-3">
							<span id="stepIndicator" class="w-8 h-8 rounded-xl bg-gradient-to-tr from-rose-600 to-pink-600 text-white font-bold flex items-center justify-center text-xs shadow-md shadow-rose-600/30">1</span>
							<h3 id="stepTitle" class="text-sm font-bold text-white uppercase tracking-wider">Personal Information</h3>
						</div>
						<span class="text-xs font-medium text-slate-400">Step <span id="currentStepNum">1</span> of 4</span>
					</div>

					<form id="biodataForm" class="space-y-6">
						
						<!-- STEP 1: Personal Information -->
						<div class="form-step space-y-4 animate-[fadeIn_0.4s_ease-in-out]" data-step="1">
							<div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
								<div>
									<label class="block text-xs font-semibold text-slate-300 mb-1.5">Full Name *</label>
									<input type="text" id="fullName" value="Rahul Sharma" class="w-full px-4 py-3 rounded-xl glass-input text-slate-100 text-sm focus:outline-none" required />
								</div>
								<div>
									<label class="block text-xs font-semibold text-slate-300 mb-1.5">Date of Birth</label>
									<input type="text" id="dob" value="15 June 1998" class="w-full px-4 py-3 rounded-xl glass-input text-slate-100 text-sm focus:outline-none" />
								</div>
								<div>
									<label class="block text-xs font-semibold text-slate-300 mb-1.5">Time of Birth</label>
									<input type="text" id="tob" value="10:30 AM" class="w-full px-4 py-3 rounded-xl glass-input text-slate-100 text-sm focus:outline-none" />
								</div>
								<div>
									<label class="block text-xs font-semibold text-slate-300 mb-1.5">Place of Birth</label>
									<input type="text" id="pob" value="Chennai, India" class="w-full px-4 py-3 rounded-xl glass-input text-slate-100 text-sm focus:outline-none" />
								</div>
								<div>
									<label class="block text-xs font-semibold text-slate-300 mb-1.5">Height & Complexion</label>
									<input type="text" id="height" value="5'11\" • Fair" class="w-full px-4 py-3 rounded-xl glass-input text-slate-100 text-sm focus:outline-none" />
								</div>
								<div>
									<label class="block text-xs font-semibold text-slate-300 mb-1.5">Religion / Caste</label>
									<input type="text" id="religion" value="Hindu • Brahmin" class="w-full px-4 py-3 rounded-xl glass-input text-slate-100 text-sm focus:outline-none" />
								</div>
							</div>
						</div>

						<!-- STEP 2: Education & Career -->
						<div class="form-step hidden space-y-4" data-step="2">
							<div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
								<div>
									<label class="block text-xs font-semibold text-slate-300 mb-1.5">Highest Education</label>
									<input type="text" id="education" value="B.Tech (IIT Madras)" class="w-full px-4 py-3 rounded-xl glass-input text-slate-100 text-sm focus:outline-none" />
								</div>
								<div>
									<label class="block text-xs font-semibold text-slate-300 mb-1.5">Occupation / Job</label>
									<input type="text" id="occupation" value="Senior Software Engineer" class="w-full px-4 py-3 rounded-xl glass-input text-slate-100 text-sm focus:outline-none" />
								</div>
								<div>
									<label class="block text-xs font-semibold text-slate-300 mb-1.5">Annual Income</label>
									<input type="text" id="income" value="18 LPA" class="w-full px-4 py-3 rounded-xl glass-input text-slate-100 text-sm focus:outline-none" />
								</div>
								<div>
									<label class="block text-xs font-semibold text-slate-300 mb-1.5">Work Location</label>
									<input type="text" id="workLocation" value="Bangalore / Chennai" class="w-full px-4 py-3 rounded-xl glass-input text-slate-100 text-sm focus:outline-none" />
								</div>
							</div>
						</div>

						<!-- STEP 3: Family Background -->
						<div class="form-step hidden space-y-4" data-step="3">
							<div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
								<div>
									<label class="block text-xs font-semibold text-slate-300 mb-1.5">Father's Name & Profession</label>
									<input type="text" id="father" value="Mr. Ramesh Sharma (Business)" class="w-full px-4 py-3 rounded-xl glass-input text-slate-100 text-sm focus:outline-none" />
								</div>
								<div>
									<label class="block text-xs font-semibold text-slate-300 mb-1.5">Mother's Name & Profession</label>
									<input type="text" id="mother" value="Mrs. Sunita Sharma (Homemaker)" class="w-full px-4 py-3 rounded-xl glass-input text-slate-100 text-sm focus:outline-none" />
								</div>
								<div>
									<label class="block text-xs font-semibold text-slate-300 mb-1.5">Siblings</label>
									<input type="text" id="siblings" value="1 Younger Sister (Married)" class="w-full px-4 py-3 rounded-xl glass-input text-slate-100 text-sm focus:outline-none" />
								</div>
								<div>
									<label class="block text-xs font-semibold text-slate-300 mb-1.5">Native Place</label>
									<input type="text" id="native" value="Madurai, Tamil Nadu" class="w-full px-4 py-3 rounded-xl glass-input text-slate-100 text-sm focus:outline-none" />
								</div>
							</div>
						</div>

						<!-- STEP 4: Photo Cropper & Contact -->
						<div class="form-step hidden space-y-4" data-step="4">
							<div class="space-y-4">
								<div>
									<label class="block text-xs font-semibold text-slate-300 mb-1.5">Upload Profile Photo</label>
									<input type="file" id="imageInput" accept="image/*" class="w-full text-xs text-slate-400 file:mr-4 file:py-2.5 file:px-5 file:rounded-xl file:border-0 file:text-xs file:font-semibold file:bg-rose-500/10 file:text-rose-300 hover:file:bg-rose-500/20 cursor-pointer glass-input" />
								</div>

								<!-- Cropper Box -->
								<div id="cropperContainer" class="hidden space-y-3 bg-slate-950/90 p-4 rounded-2xl border border-slate-800 shadow-2xl">
									<div class="max-h-60 overflow-hidden flex justify-center">
										<img id="imageToCrop" class="max-w-full block" />
									</div>
									<button type="button" id="cropBtn" class="w-full py-2.5 bg-gradient-to-r from-rose-600 to-pink-600 hover:from-rose-500 text-white text-xs font-bold rounded-xl transition-all shadow-md shadow-rose-600/30">
										Crop & Apply Photo
									</button>
								</div>

								<div class="grid grid-cols-1 sm:grid-cols-2 gap-4 pt-2">
									<div>
										<label class="block text-xs font-semibold text-slate-300 mb-1.5">Mobile / WhatsApp</label>
										<input type="text" id="phone" value="+91 98765 43210" class="w-full px-4 py-3 rounded-xl glass-input text-slate-100 text-sm focus:outline-none" />
									</div>
									<div>
										<label class="block text-xs font-semibold text-slate-300 mb-1.5">Residential Address</label>
										<input type="text" id="address" value="T. Nagar, Chennai, Tamil Nadu" class="w-full px-4 py-3 rounded-xl glass-input text-slate-100 text-sm focus:outline-none" />
									</div>
								</div>
							</div>
						</div>

						<!-- Step Navigation Controls -->
						<div class="flex items-center justify-between pt-6 border-t border-slate-800">
							<button type="button" id="prevBtn" class="px-6 py-3 text-xs font-bold text-slate-300 bg-slate-800/80 hover:bg-slate-700 rounded-xl transition-all disabled:opacity-30 disabled:cursor-not-allowed" disabled>
								← Previous
							</button>
							<button type="button" id="nextBtn" class="px-7 py-3 text-xs font-bold text-white bg-gradient-to-r from-rose-600 to-pink-600 hover:from-rose-500 rounded-xl shadow-lg shadow-rose-600/30 transition-all transform hover:-translate-y-0.5">
								Next Step →
							</button>
						</div>

					</form>
				</div>

				<!-- Right Column: Live A4 Preview Paper & PDF Action -->
				<div class="lg:col-span-5 sticky top-28 space-y-6">
					<div class="glass-card rounded-3xl p-6 shadow-2xl">
						<div class="flex items-center justify-between mb-4">
							<h3 class="text-sm font-bold text-white flex items-center space-x-2">
								<span>👁️</span>
								<span>Live A4 Preview</span>
							</h3>
							<span class="text-[11px] px-3 py-1 rounded-full bg-emerald-500/10 text-emerald-400 border border-emerald-500/20 font-semibold">Print Ready</span>
						</div>

						<!-- A4 Paper Card Preview -->
						<div id="biodataPreviewCard" class="bg-white text-slate-900 rounded-2xl p-6 shadow-inner font-sans border border-slate-200 relative overflow-hidden">
							<div class="flex items-start justify-between border-b border-rose-200 pb-4">
								<div>
									<div class="text-[10px] font-bold text-rose-600 uppercase tracking-widest mb-1">॥ Shri Ganeshaya Namah ॥</div>
									<h2 id="prevName" class="text-xl font-bold text-slate-900">Rahul Sharma</h2>
									<p id="prevReligion" class="text-[11px] text-slate-600 mt-0.5">Hindu • Brahmin</p>
								</div>
								<div id="previewPhotoBox" class="w-16 h-20 bg-slate-100 border border-rose-200 rounded-lg overflow-hidden flex items-center justify-center text-slate-400 text-[10px] shadow-sm">
									<span id="photoPlaceholder">Photo</span>
									<img id="previewCroppedImg" class="w-full h-full object-cover hidden" />
								</div>
							</div>

							<div class="space-y-3 pt-3 text-[11px]">
								<div>
									<h4 class="font-bold text-rose-700 uppercase tracking-wider border-b border-rose-100 pb-0.5 mb-1">Personal Info</h4>
									<div class="grid grid-cols-2 gap-x-2 gap-y-0.5 text-slate-700">
										<p><strong>DOB:</strong> <span id="prevDob">15 June 1998</span></p>
										<p><strong>Time:</strong> <span id="prevTob">10:30 AM</span></p>
										<p><strong>Birth Place:</strong> <span id="prevPob">Chennai, India</span></p>
										<p><strong>Height:</strong> <span id="prevHeight">5'11" • Fair</span></p>
									</div>
								</div>

								<div>
									<h4 class="font-bold text-rose-700 uppercase tracking-wider border-b border-rose-100 pb-0.5 mb-1">Education & Career</h4>
									<div class="grid grid-cols-1 gap-y-0.5 text-slate-700">
										<p><strong>Education:</strong> <span id="prevEdu">B.Tech (IIT Madras)</span></p>
										<p><strong>Occupation:</strong> <span id="prevOcc">Senior Software Engineer (18 LPA)</span></p>
									</div>
								</div>

								<div>
									<h4 class="font-bold text-rose-700 uppercase tracking-wider border-b border-rose-100 pb-0.5 mb-1">Family Details</h4>
									<div class="grid grid-cols-1 gap-y-0.5 text-slate-700">
										<p><strong>Father:</strong> <span id="prevFather">Mr. Ramesh Sharma (Business)</span></p>
										<p><strong>Mother:</strong> <span id="prevMother">Mrs. Sunita Sharma (Homemaker)</span></p>
									</div>
								</div>

								<div>
									<h4 class="font-bold text-rose-700 uppercase tracking-wider border-b border-rose-100 pb-0.5 mb-1">Contact</h4>
									<div class="grid grid-cols-1 gap-y-0.5 text-slate-700">
										<p><strong>Phone:</strong> <span id="prevPhone">+91 98765 43210</span></p>
										<p><strong>Address:</strong> <span id="prevAddress">T. Nagar, Chennai, TN</span></p>
									</div>
								</div>
							</div>
						</div>

						<div class="mt-6">
							<button id="downloadPdfBtn" class="w-full py-3.5 px-4 bg-gradient-to-r from-emerald-600 to-teal-600 hover:from-emerald-500 hover:to-teal-500 text-white font-bold rounded-2xl shadow-xl shadow-emerald-600/30 transition-all flex items-center justify-center space-x-2 text-sm transform hover:-translate-y-0.5">
								<span>📥</span>
								<span>Download Print-Ready PDF</span>
							</button>
							<p class="text-center text-[11px] text-slate-400 mt-2">100% Free • Generated securely on your browser</p>
						</div>
					</div>
				</div>

			</div>
		</main>

		<!-- Pricing & Templates Section -->
		<section id="templates" class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16 border-t border-slate-800/80">
			<div class="text-center max-w-2xl mx-auto mb-12">
				<h2 class="text-2xl sm:text-3xl font-bold text-white mb-3">Choose Your Preferred Format</h2>
				<p class="text-sm text-slate-400">Available in traditional, modern minimalist, and regional community layouts.</p>
			</div>
			<div id="pricing" class="grid grid-cols-1 md:grid-cols-3 gap-6">
				<!-- Free Plan -->
				<div class="glass-card rounded-3xl p-6 flex flex-col justify-between">
					<div>
						<h3 class="text-lg font-bold text-white mb-1">Basic Free</h3>
						<p class="text-xs text-slate-400 mb-4">Ideal for immediate WhatsApp sharing.</p>
						<div class="text-2xl font-extrabold text-white mb-6">₹0 <span class="text-xs text-slate-400 font-normal">/ forever</span></div>
						<ul class="space-y-3 text-xs text-slate-300 mb-8">
							<li class="flex items-center space-x-2"><span class="text-rose-500">✓</span><span>Instant A4 PDF Export</span></li>
							<li class="flex items-center space-x-2"><span class="text-rose-500">✓</span><span>Built-in Photo Cropper</span></li>
							<li class="flex items-center space-x-2"><span class="text-rose-500">✓</span><span>No Account Required</span></li>
						</ul>
					</div>
					<a href="#builder" class="w-full py-2.5 text-center text-xs font-semibold text-white bg-slate-800 hover:bg-slate-700 rounded-xl transition-all">Get Started Free</a>
				</div>
				<!-- Pro Pass -->
				<div class="glass-card rounded-3xl p-6 border-2 border-rose-500/50 flex flex-col justify-between relative shadow-xl shadow-rose-600/10">
					<div class="absolute -top-3 left-1/2 -translate-x-1/2 px-3 py-0.5 bg-rose-600 text-white text-[10px] font-bold rounded-full uppercase tracking-wider">Most Popular</div>
					<div>
						<h3 class="text-lg font-bold text-white mb-1">Pro Gold Pass</h3>
						<p class="text-xs text-slate-400 mb-4">Unlock royal decorative borders & horoscope charts.</p>
						<div class="text-2xl font-extrabold text-rose-400 mb-6">₹99 <span class="text-xs text-slate-400 font-normal">/ one-time</span></div>
						<ul class="space-y-3 text-xs text-slate-300 mb-8">
							<li class="flex items-center space-x-2"><span class="text-rose-500">✓</span><span>All 50+ Premium Templates</span></li>
							<li class="flex items-center space-x-2"><span class="text-rose-500">✓</span><span>Kundali / Horoscope Grid</span></li>
							<li class="flex items-center space-x-2"><span class="text-rose-500">✓</span><span>Watermark-free HD Export</span></li>
						</ul>
					</div>
					<a href="#builder" class="w-full py-2.5 text-center text-xs font-semibold text-white bg-gradient-to-r from-rose-600 to-pink-600 hover:from-rose-500 rounded-xl transition-all shadow-lg shadow-rose-600/20">Upgrade Now</a>
				</div>
				<!-- Regional Edition -->
				<div class="glass-card rounded-3xl p-6 flex flex-col justify-between">
