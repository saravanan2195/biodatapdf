		<!-- JavaScript Logic: Tabs, Live Binding, Cropper & PDF Export -->
		<script>
			// Tab Switcher Logic
			const tabButtons = document.querySelectorAll('.tab-btn');
			const tabContents = document.querySelectorAll('.tab-content');

			tabButtons.forEach(btn => {
				btn.addEventListener('click', () => {
					tabButtons.forEach(b => b.classList.remove('active', 'text-rose-600', 'font-semibold'));
					tabButtons.forEach(b => b.classList.add('text-slate-500'));
					btn.classList.add('active', 'text-rose-600', 'font-semibold');
					btn.classList.remove('text-slate-500');

					const targetTab = btn.getAttribute('data-tab');
					tabContents.forEach(content => {
						if (content.id === `tab-${targetTab}`) {
							content.classList.remove('hidden');
						} else {
							content.classList.add('hidden');
						}
					});
				});
			});

			// Live Text Bindings
			const bindings = {
				fullName: { input: document.getElementById('fullName'), prev: document.getElementById('prevName') },
				dob: { input: document.getElementById('dob'), prev: document.getElementById('prevDob') },
				tob: { input: document.getElementById('tob'), prev: document.getElementById('prevTob') },
				pob: { input: document.getElementById('pob'), prev: document.getElementById('prevPob') },
				height: { input: document.getElementById('height'), prev: document.getElementById('prevHeight') },
				bloodGroup: { input: document.getElementById('bloodGroup'), prev: document.getElementById('prevBlood') },
				maritalStatus: { input: document.getElementById('maritalStatus'), prev: document.getElementById('prevMarital') },
				religion: { input: document.getElementById('religion'), prev: document.getElementById('prevReligion') },
				caste: { input: document.getElementById('caste'), prev: document.getElementById('prevCaste') },
				gotra: { input: document.getElementById('gotra'), prev: document.getElementById('prevGotra') },
				rashi: { input: document.getElementById('rashi'), prev: document.getElementById('prevRashi') },
				nakshatra: { input: document.getElementById('nakshatra'), prev: document.getElementById('prevNakshatra') },
				manglik: { input: document.getElementById('manglik'), prev: document.getElementById('prevManglik') },
				education: { input: document.getElementById('education'), prev: document.getElementById('prevEdu') },
				college: { input: document.getElementById('college'), prev: document.getElementById('prevCollege') },
				occupation: { input: document.getElementById('occupation'), prev: document.getElementById('prevOcc') },
				company: { input: document.getElementById('company'), prev: document.getElementById('prevCompany') },
				workLocation: { input: document.getElementById('workLocation'), prev: document.getElementById('prevLocation') },
				income: { input: document.getElementById('income'), prev: document.getElementById('prevIncome') },
				father: { input: document.getElementById('father'), prev: document.getElementById('prevFather') },
				mother: { input: document.getElementById('mother'), prev: document.getElementById('prevMother') },
				siblings: { input: document.getElementById('siblings'), prev: document.getElementById('prevSiblings') },
				familyValues: { input: document.getElementById('familyValues'), prev: document.getElementById('prevFamilyStatus') },
				phone: { input: document.getElementById('phone'), prev: document.getElementById('prevPhone') },
				address: { input: document.getElementById('address'), prev: document.getElementById('prevAddress') },
			};

			Object.keys(bindings).forEach(k => {
				if (bindings[k].input && bindings[k].prev) {
					bindings[k].input.addEventListener('input', (e) => {
						bindings[k].prev.textContent = e.target.value || '-';
					});
				}
			});

			// Sample Auto-Fill Buttons
			document.getElementById('groomSampleBtn').addEventListener('click', () => {
				document.getElementById('fullName').value = "Aarav Devendra Sharma";
				document.getElementById('gender').value = "Male";
				document.getElementById('dob').value = "14-08-1996";
				document.getElementById('occupation').value = "Senior Machine Learning Engineer";
				document.getElementById('income').value = "48,00,000 INR";
				// Trigger input event to update preview
				Object.keys(bindings).forEach(k => {
					if(bindings[k].input) bindings[k].input.dispatchEvent(new Event('input'));
				});
			});

			document.getElementById('brideSampleBtn').addEventListener('click', () => {
				document.getElementById('fullName').value = "Ananya Ramesh Kumar";
				document.getElementById('gender').value = "Female";
				document.getElementById('dob').value = "22-05-1998";
				document.getElementById('occupation').value = "Senior Product Designer";
				document.getElementById('income').value = "36,00,000 INR";
				Object.keys(bindings).forEach(k => {
					if(bindings[k].input) bindings[k].input.dispatchEvent(new Event('input'));
				});
			});

			// Cropper.js Integration
			let cropper = null;
			const imageInput = document.getElementById('imageInput');
			const triggerCropBtn = document.getElementById('triggerCropBtn');
			const cropperContainer = document.getElementById('cropperContainer');
			const imageToCrop = document.getElementById('imageToCrop');
			const applyCropBtn = document.getElementById('applyCropBtn');
			const photoPlaceholder = document.getElementById('photoPlaceholder');
			const previewCroppedImg = document.getElementById('previewCroppedImg');
			let croppedDataUrl = null;

			triggerCropBtn.addEventListener('click', () => {
				imageInput.click();
			});

			imageInput.addEventListener('change', (e) => {
				const files = e.target.files;
				if (files && files.length > 0) {
					const file = files[0];
					const reader = new FileReader();
					reader.onload = (event) => {
						imageToCrop.src = event.target.result;
						cropperContainer.classList.remove('hidden');
						if (cropper) cropper.destroy();
						cropper = new Cropper(imageToCrop, {
							aspectRatio: 3 / 4,
							viewMode: 1,
						});
					};
					reader.readAsDataURL(file);
				}
			});

			applyCropBtn.addEventListener('click', () => {
				if (cropper) {
					const canvas = cropper.getCroppedCanvas({ width: 300, height: 400 });
					croppedDataUrl = canvas.toDataURL('image/jpeg');
					previewCroppedImg.src = croppedDataUrl;
					previewCroppedImg.classList.remove('hidden');
					photoPlaceholder.classList.add('hidden');
					cropperContainer.classList.add('hidden');
				}
			});

			document.getElementById('removePhotoBtn').addEventListener('click', () => {
				croppedDataUrl = null;
				previewCroppedImg.src = '';
				previewCroppedImg.classList.add('hidden');
				photoPlaceholder.classList.remove('hidden');
			});

			// PDF Export via jsPDF
			function generatePDF() {
				const { jsPDF } = window.jspdf;
				const doc = new jsPDF('p', 'mm', 'a4');

				doc.setFont("Helvetica", "bold");
				doc.setFontSize(11);
				doc.setTextColor(180, 50, 50);
				doc.text("|| Shri Ganeshaya Namah ||", 105, 15, { align: "center" });

				doc.setFontSize(20);
				doc.setTextColor(15, 23, 42);
				doc.text(bindings.fullName.input.value || "Marriage Biodata", 105, 24, { align: "center" });

				if (croppedDataUrl) {
					doc.addImage(croppedDataUrl, 'JPEG', 165, 12, 28, 36);
				}

				let y = 38;
				function addSection(title, dataObj) {
					doc.setFillColor(120, 20, 40);
					doc.rect(20, y, 170, 6, "F");
					doc.setFont("Helvetica", "bold");
					doc.setFontSize(9);
					doc.setTextColor(255, 255, 255);
					doc.text(title, 23, y + 4);
					y += 9;

					doc.setFont("Helvetica", "normal");
					doc.setFontSize(9);
					doc.setTextColor(30, 41, 59);

					Object.keys(dataObj).forEach(label => {
						doc.setFont("Helvetica", "bold");
						doc.text(label + ":", 22, y);
						doc.setFont("Helvetica", "normal");
						doc.text(dataObj[label], 75, y);
						y += 5.5;
					});
					y += 3;
				}

				addSection("PERSONAL DETAILS", {
					"Date of Birth": bindings.dob.input.value,
					"Time of Birth": bindings.tob.input.value,
					"Place of Birth": bindings.pob.input.value,
					"Height": bindings.height.input.value,
					"Blood Group": bindings.bloodGroup.input.value,
					"Marital Status": bindings.maritalStatus.input.value
				});

				addSection("RELIGIOUS & ASTROLOGICAL DETAILS", {
					"Religion": bindings.religion.input.value,
					"Caste": bindings.caste.input.value,
					"Gotra": bindings.gotra.input.value,
					"Rashi": bindings.rashi.input.value,
					"Nakshatra": bindings.nakshatra.input.value,
					"Manglik Status": bindings.manglik.input.value
				});

				addSection("EDUCATION & CAREER DETAILS", {
					"Highest Qualification": bindings.education.input.value,
					"College / University": bindings.college.input.value,
					"Occupation": bindings.occupation.input.value,
					"Company Name": bindings.company.input.value,
					"Work Location": bindings.workLocation.input.value,
					"Annual Income": bindings.income.input.value
				});

				addSection("FAMILY BACKGROUND", {
					"Father's Details": bindings.father.input.value,
					"Mother's Details": bindings.mother.input.value,
					"Siblings": bindings.siblings.input.value,
					"Family Status": bindings.familyValues.input.value
				});

				addSection("CONTACT & ADDRESS", {
					"Mobile / WhatsApp": bindings.phone.input.value,
					"Address": bindings.address.input.value
				});

				doc.save(`${(bindings.fullName.input.value || 'Biodata').replace(/\s+/g, '_')}_Biodata.pdf`);
			}

			document.getElementById('downloadPdfBtn').addEventListener('click', generatePDF);
			document.getElementById('headerDownloadBtn').addEventListener('click', generatePDF);
		</script>
	</body>
